# Copy this file to backend/.env and fill in your PostgreSQL details.
# The database is created and seeded automatically on first start.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=nepal_payroll

# API port (the frontend dev server reads this too)
PORT=4000

# Or use a single connection string instead of the DB_* values above
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nepal_payroll
